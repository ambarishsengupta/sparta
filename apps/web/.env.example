# Copy to .env.local (git-ignored) and fill in. The browser gets only the publishable key (the NEXT_PUBLIC_ values); the secret key below is server-only (lib/server/admin.ts).
# For the local stack, `supabase status -o json` prints API_URL and PUBLISHABLE_KEY.
NEXT_PUBLIC_DATA_BACKEND=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shown on the About page (FR-67). Public values, set at build time. Empty means the page says they are not configured.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_HOSTING_REGION=
# SERVER ONLY (never NEXT_PUBLIC_*, never committed with a value). Read by lib/server/admin.ts and the worker route only.
# SUPABASE_SECRET_KEY: for the local stack `supabase status -o json` prints SECRET_KEY; the Leave flow's file removal and the worker's signed URLs need it.
# WORKER_API_TOKEN: random, at least 32 characters; the worker sends it as `Authorization: Bearer <token>`.
SUPABASE_SECRET_KEY=
WORKER_API_TOKEN=
