# Copy to .env.local (git-ignored) and fill in. Only the publishable key belongs here; the app never uses any other Supabase key.
# For the local stack, `supabase status -o json` prints API_URL and PUBLISHABLE_KEY.
NEXT_PUBLIC_DATA_BACKEND=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shown on the About page (FR-67). Public values, set at build time. Empty means the page says they are not configured.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_HOSTING_REGION=
