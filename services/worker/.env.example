# Copy to .env (git-ignored) and fill in. NEVER commit .env. The worker never holds the Supabase secret key.
# The password of worker_role: locally set with the git-ignored supabase/scripts/set-worker-password.sh (see README.md).
WORKER_DATABASE_URL=postgresql://worker_role:CHANGE_ME@host.docker.internal:54322/postgres
WORKER_API_BASE_URL=http://host.docker.internal:3000
WORKER_API_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# The local stack's signed URLs say 127.0.0.1:54321, which a container cannot reach (allow-listed hosts only).
SIGNED_URL_HOST_REWRITE=host.docker.internal:54321
GARMENT_GUESS_ENABLED=false
GARMENT_MODEL_VERSION=garment-cnn-v1
GARMENT_MIN_CONFIDENCE=0.6
