# Copy this file to workflow/local.env (git-ignored) and set the five absolute paths for this machine.
# Scripts and agents read these settings. Never use a relative path, and never rely on the
# data/recommendation-engine/hm symlink: it is a convenience only and does not exist in a worktree or a fresh checkout.
# Quote a path that contains a space or an ampersand.

# Folder with the H&M files (articles.csv, customers.csv, transactions_train.csv, images/)
SPARTA_DATA_ROOT_HM="/absolute/path/to/H&M"

# Folder with the Fashion-MNIST files (the four IDX files; the CSV copies are not used for training)
SPARTA_DATA_ROOT_MNIST="/absolute/path/to/Fashion MNIST"

# Folder with the team's own photos of garments, for the release R5 evaluation and Model QC (LLD 7.7).
# Kept outside the repository and the database; deleted after the evaluation (LLD 13.4).
SPARTA_TEAM_PHOTOS="/absolute/path/to/team-photos"

# The one folder for H&M derived caches: background-removed cut-outs and split lists (LLD 13.4).
# It is the only place an H&M-derived image may exist outside SPARTA_DATA_ROOT_HM. Outside the repository;
# deleted when the model cards are final.
SPARTA_HM_CACHE="/absolute/path/to/hm-cache"

# Folder holding the trained files (garment-cnn-v2.onnx, pairing-prior-v1.json, unlock-candidates.json),
# so Model QC can re-run the model cards on a fresh checkout. Outside the repository; never committed.
SPARTA_ARTIFACT_DIR="/absolute/path/to/artifacts"
